#!/usr/bin/env python3
"""Live preview in a browser, with no dependencies and no transcoding.

The frames coming off the card are already JPEGs, and a multipart/x-mixed-replace
response of concatenated JPEGs is exactly what every browser renders as a live image. So
a viewer needs no decoder, no GUI toolkit and no encoder -- only http.server, which is in
the standard library. Open the printed URL.

This is for checking that the card sees what you think it sees. It is not a low-latency
monitor: the browser adds buffering, and the card has an HDMI loop-out that drives a real
display with no added latency at all. Use the loop-out for anything where latency matters
to a human operator, and this for confirming a capture is working from a terminal.

Only one client at a time gets frames; a second connection is served the same stream from
the same source, which halves neither the rate nor the quality but does double the
bandwidth.
"""
from __future__ import annotations

import argparse
import http.server
import socketserver
import sys
import threading

import _bootstrap  # noqa: F401
from vcap.device import find_capture_card
from vcap.ring import LatestFrame
from vcap.source import NoSignal, StreamError, VideoSource

BOUNDARY = "vcapframe"

PAGE = """<!doctype html>
<title>vcap preview</title>
<style>
  :root { color-scheme: light dark }
  body { margin:0; background:#111; display:grid; place-items:center; min-height:100vh }
  img { max-width:100vw; max-height:100vh; display:block }
</style>
<img src="/stream.mjpg" alt="live capture">
"""


class Handler(http.server.BaseHTTPRequestHandler):
    latest: LatestFrame = None          # set on the class before the server starts
    protocol_version = "HTTP/1.1"

    def log_message(self, *args):
        pass                            # the capture loop owns the terminal

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            body = PAGE.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        if self.path != "/stream.mjpg":
            self.send_error(404)
            return

        self.send_response(200)
        self.send_header("Age", "0")
        self.send_header("Cache-Control", "no-store, no-cache, must-revalidate")
        self.send_header("Content-Type",
                         f"multipart/x-mixed-replace; boundary={BOUNDARY}")
        self.end_headers()
        generation = -1
        try:
            while True:
                frame, generation = self.latest.wait_for_new(generation, timeout=5.0)
                if frame is None:
                    continue
                # A partial JPEG renders as a broken image and can wedge some decoders,
                # and the first frame off this card is reliably partial. Skipping them
                # here is display policy, not data policy -- the recorder still writes
                # them, flagged.
                if not frame.ok:
                    continue
                self.wfile.write(b"--" + BOUNDARY.encode() + b"\r\n")
                self.wfile.write(b"Content-Type: image/jpeg\r\n")
                self.wfile.write(
                    b"Content-Length: " + str(len(frame)).encode() + b"\r\n\r\n")
                self.wfile.write(frame.data)
                self.wfile.write(b"\r\n")
        except (BrokenPipeError, ConnectionResetError):
            return                      # the browser navigated away


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("-d", "--device", help="by-id path, /dev/videoN, or a name substring")
    ap.add_argument("--size", default="1280x720",
                    help="WIDTHxHEIGHT; smaller is kinder to a browser (default 1280x720)")
    ap.add_argument("--fps", type=float, default=30.0)
    ap.add_argument("--port", type=int, default=8420)
    ap.add_argument("--bind", default="127.0.0.1",
                    help="0.0.0.0 to allow other machines; the stream is unauthenticated")
    args = ap.parse_args()

    width, _, height = args.size.partition("x")
    try:
        device = find_capture_card(args.device)
    except LookupError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    latest = LatestFrame()
    Handler.latest = latest

    server = Server((args.bind, args.port), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    print(f"http://{args.bind}:{args.port}/    ({device.path})")
    print("Ctrl-C to stop\n")

    try:
        with VideoSource(device, "MJPG", int(width), int(height), fps=args.fps) as src:
            for frame in src.frames(patience=None):
                latest.put(frame)
    except KeyboardInterrupt:
        return 0
    except NoSignal as exc:
        print(f"no signal: {exc}", file=sys.stderr)
        return 1
    except StreamError as exc:
        print(f"stream failed: {exc}", file=sys.stderr)
        return 1
    finally:
        server.shutdown()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
