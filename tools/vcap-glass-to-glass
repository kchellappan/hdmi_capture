#!/usr/bin/env python3
"""Measure the delay from a page drawing something to the frame arriving in the kernel.

A frame's timestamp says when the USB frame reached the kernel. It does not say when the
photons left the display, and the difference -- the source's output pipeline, the card's
buffering, the USB transfer -- is tens of milliseconds that no API reports. An action
recorded 50 ms before the frame it caused trains a policy to act early, consistently
enough to look like a control-tuning problem rather than a data bug.

tools/vcap-latency gives half the measurement and needs a control recording for the other
half. This gives the whole thing, using the one trick available when the machine driving
the display is also the machine capturing it: put a clock on the screen and read it back.

  1. Connect this machine's HDMI output to the capture card's input, so the card sees a
     display this machine is driving.
  2. Run this. Open the printed URL on that display and press F11 for fullscreen.
  3. It reports the round trip.

The page draws a pattern of large black and white bars encoding the current time in
milliseconds, on the server's CLOCK_MONOTONIC. Each captured frame is decoded back to that
number and subtracted from the frame's own timestamp. Both ends are therefore on one clock
on one machine, which is the same property the whole repo rests on -- see docs/timebase.md.

WHAT THIS MEASURES, PRECISELY: the interval from a browser's requestAnimationFrame callback
running to the kernel timestamping the frame that shows its output. That includes compositing,
scanout, the cable, the card and the USB transfer.

WHAT IT DOES NOT: a browser cannot report when a frame actually reached the glass.
requestAnimationFrame fires before compositing, so the true photon-to-kernel interval is
SHORTER than this figure by up to one refresh period -- about 16 ms at 60 Hz. Treat the
result as an upper bound, and subtract half a refresh period if you want a central estimate.
It is reported here uncorrected, because a correction folded in silently cannot be undone
by whoever reads the number later.
"""
from __future__ import annotations

import argparse
import http.server
import json
import socketserver
import statistics
import sys
import threading
import time

import _bootstrap  # noqa: F401
from vcap.barcode import (BAND_HEIGHT, BAND_TOP, BAR_WIDTH, DATA_BITS, WRAP_MS,
                          DecodeError, SYNC_BARS, TOTAL_BARS, decode_dc_image,
                          reconstruct_ms)
from vcap.device import find_capture_card
from vcap.jpeg_dc import JpegError, decode_dc
from vcap.source import NoSignal, StreamError, VideoSource

PAGE = """<!doctype html>
<title>vcap glass-to-glass</title>
<style>
  html, body { margin:0; padding:0; background:#000; overflow:hidden; height:100%%; }
  #band { position:fixed; left:0; width:100%%; display:flex; }
  #band div { height:100%%; }
  #status { position:fixed; bottom:2vh; left:2vw; color:#666;
            font:14px ui-monospace, monospace; }
</style>
<div id="band"></div>
<div id="status">measuring clock offset...</div>
<script>
const BARS = %(total_bars)d, SYNC = %(sync_bars)d, DATA = %(data_bits)d;
const BAR_W = %(bar_width)f, BAND_TOP = %(band_top)f, BAND_H = %(band_height)f;

const band = document.getElementById('band');
band.style.top = (BAND_TOP * 100) + 'vh';
band.style.height = (BAND_H * 100) + 'vh';
const cells = [];
for (let i = 0; i < BARS; i++) {
  const d = document.createElement('div');
  d.style.width = (BAR_W * 100) + 'vw';
  band.appendChild(d);
  cells.push(d);
}

function checksum(v) {
  let c = 0;
  for (let s = 0; s < DATA; s += 4) c ^= (v >>> s) & 0xF;
  return c & 0xF;
}

// The browser's clock is not the server's. Sample the offset several times and keep the
// exchange with the smallest round trip, which is the one least distorted by scheduling.
// This is the only place the two clocks meet; everything after it is in server time.
async function measureOffset(samples) {
  let best = null;
  for (let i = 0; i < samples; i++) {
    const t0 = performance.now();
    const r = await fetch('/time', {cache: 'no-store'});
    const t1 = performance.now();
    const serverMs = (await r.json()).monotonic_ns / 1e6;
    const rtt = t1 - t0;
    if (best === null || rtt < best.rtt) {
      best = {rtt: rtt, offset: serverMs + rtt / 2 - t1};
    }
  }
  return best;
}

let offset = 0, painted = 0;
function draw(rafMs) {
  // rafMs is the time this frame is INTENDED to be displayed, which is the best estimate
  // a page has. It still precedes actual scanout; see the tool's docstring.
  const serverMs = Math.round(rafMs + offset);
  const value = ((serverMs %% %(wrap_ms)d) + %(wrap_ms)d) %% %(wrap_ms)d;
  const bits = [1, 0];
  for (let i = DATA - 1; i >= 0; i--) bits.push((value >>> i) & 1);
  const c = checksum(value);
  for (let i = 3; i >= 0; i--) bits.push((c >>> i) & 1);
  for (let i = 0; i < BARS; i++) cells[i].style.background = bits[i] ? '#fff' : '#000';
  painted++;
  requestAnimationFrame(draw);
}

measureOffset(20).then(best => {
  offset = best.offset;
  document.getElementById('status').textContent =
    'clock offset locked, round trip ' + best.rtt.toFixed(2) + ' ms - press F11';
  requestAnimationFrame(draw);
});
</script>
"""


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *args):
        pass                              # the measurement owns the terminal

    def _send(self, body: bytes, content_type: str) -> None:
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.startswith("/time"):
            self._send(json.dumps({"monotonic_ns": time.monotonic_ns()}).encode(),
                       "application/json")
            return
        if self.path in ("/", "/index.html"):
            page = PAGE % {
                "total_bars": TOTAL_BARS, "sync_bars": SYNC_BARS, "data_bits": DATA_BITS,
                "bar_width": BAR_WIDTH, "band_top": BAND_TOP, "band_height": BAND_HEIGHT,
                "wrap_ms": WRAP_MS,
            }
            self._send(page.encode(), "text/html; charset=utf-8")
            return
        self.send_error(404)


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("-d", "--device", help="by-id path, /dev/videoN, or a name substring")
    ap.add_argument("--size", default="1920x1080")
    ap.add_argument("--fps", type=float, default=60.0)
    ap.add_argument("--port", type=int, default=8421)
    ap.add_argument("--bind", default="127.0.0.1")
    ap.add_argument("--samples", type=int, default=120,
                    help="successful decodes to collect (default 120)")
    ap.add_argument("--timeout", type=float, default=120.0,
                    help="give up after this long (default 120 s)")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    width, _, height = args.size.partition("x")
    try:
        device = find_capture_card(args.device)
    except LookupError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    server = Server((args.bind, args.port), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()

    if not args.json:
        print(f"\n  1. open  http://{args.bind}:{args.port}/  on the display this "
              f"machine feeds to the capture card")
        print("  2. press F11 for fullscreen")
        print(f"  3. waiting for {args.samples} readable frames "
              f"(up to {args.timeout:g} s)\n", flush=True)

    latencies: list[float] = []
    decode_failures = 0
    jpeg_failures = 0
    first_seen = False
    deadline = time.monotonic() + args.timeout
    exit_code = 0

    try:
        with VideoSource(device, "MJPG", int(width), int(height), fps=args.fps) as src:
            for frame in src.frames(timeout=3.0, patience=None):
                if time.monotonic() > deadline:
                    break
                if not frame.ok:
                    continue
                try:
                    image = decode_dc(frame.data)
                except JpegError:
                    jpeg_failures += 1
                    continue
                try:
                    encoded = decode_dc_image(image)
                except DecodeError:
                    decode_failures += 1
                    continue

                frame_ms = frame.ts_mono_ns / 1e6
                painted_ms = reconstruct_ms(encoded, frame_ms)
                latency = frame_ms - painted_ms
                # A negative or absurd value means the pattern was misread in a way the
                # checksum did not catch, or the page had not locked its clock offset yet.
                if not -50.0 < latency < 1000.0:
                    decode_failures += 1
                    continue
                latencies.append(latency)
                if not first_seen and not args.json:
                    print("  pattern acquired\n", flush=True)
                    first_seen = True
                if len(latencies) >= args.samples:
                    break
                if not args.json and len(latencies) % 20 == 0:
                    sys.stderr.write(f"\r  {len(latencies)}/{args.samples} samples   ")
                    sys.stderr.flush()
    except NoSignal as exc:
        print(f"\nno signal: {exc}", file=sys.stderr)
        exit_code = 1
    except StreamError as exc:
        print(f"\nstream failed: {exc}", file=sys.stderr)
        exit_code = 1
    except KeyboardInterrupt:
        pass
    finally:
        server.shutdown()

    if not args.json:
        sys.stderr.write("\n")

    if not latencies:
        print("no readable frames. Is the page fullscreen on the display the card is "
              "capturing?", file=sys.stderr)
        if jpeg_failures:
            print(f"({jpeg_failures} frames could not be DC-decoded)", file=sys.stderr)
        return 1

    result = {
        "samples": len(latencies),
        "median_ms": round(statistics.median(latencies), 2),
        "mean_ms": round(statistics.mean(latencies), 2),
        "min_ms": round(min(latencies), 2),
        "max_ms": round(max(latencies), 2),
        "stdev_ms": round(statistics.stdev(latencies), 2) if len(latencies) > 2 else 0.0,
        "decode_failures": decode_failures,
        "jpeg_failures": jpeg_failures,
        "capture_offset_ns": int(statistics.median(latencies) * 1e6),
        "method": "glass-to-glass, browser rAF to kernel frame timestamp, "
                  "uncorrected for pre-scanout bias",
    }
    if args.json:
        print(json.dumps(result, indent=2))
        return exit_code

    print(f"  samples          {result['samples']}")
    print(f"  median           {result['median_ms']:.2f} ms")
    print(f"  mean             {result['mean_ms']:.2f} ms")
    print(f"  min / max        {result['min_ms']:.2f} / {result['max_ms']:.2f} ms")
    print(f"  stdev            {result['stdev_ms']:.2f} ms")
    print(f"  unreadable       {result['decode_failures']} decodes, "
          f"{result['jpeg_failures']} frames")
    print()
    print(f"  This is an UPPER BOUND. requestAnimationFrame fires before compositing, so")
    print(f"  true photon-to-kernel latency is shorter by up to one refresh period")
    print(f"  (~{1000 / 60:.0f} ms at 60 Hz). Reported uncorrected on purpose.")
    print()
    print(f"  Record it in a session manifest as:")
    print(f'    timebase.capture_offset_ns = {result["capture_offset_ns"]}')
    print(f'    timebase.capture_offset_method = "{result["method"]}"')
    print(f"  Do not fold it into frame timestamps -- see docs/timebase.md.")
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
